# Production environment template for the quackmem-using service.
#
# Copy to `quackmem.env`, fill in real values, and reference it from
# docker-compose.prod.yml via `env_file:`. Do NOT commit the populated file —
# .dockerignore already excludes *.env.

# ─── quackmem ────────────────────────────────────────────────────────────────
# Required. Connection string to your Postgres. The library auto-rewrites the
# driver to asyncpg, so plain `postgresql://...` is accepted.
QUACKMEM_DATABASE_URL=postgresql://quackmem:CHANGE_ME@db:5432/quackmem

# Optional — defaults shown.
# QUACKMEM_SCHEMA_NAME=public
# QUACKMEM_TABLE_PREFIX=
# QUACKMEM_POOL_SIZE=5
# QUACKMEM_MAX_OVERFLOW=10
# QUACKMEM_ECHO=false

# ─── Postgres (read by the bundled `db` service in docker-compose.prod.yml) ──
# Must match the credentials inside QUACKMEM_DATABASE_URL above.
POSTGRES_DB=quackmem
POSTGRES_USER=quackmem
POSTGRES_PASSWORD=CHANGE_ME

# ─── Application ─────────────────────────────────────────────────────────────
# Add your own service-specific env vars below as needed.
